# Ready-made requests for the Crafting Planner API.
# Visual Studio, VS Code (REST Client extension), and Rider show a "Send request"
# link above each one. Start the app first with: dotnet run

@baseUrl = http://localhost:5080

### List items (first page, sorted by name)
GET {{baseUrl}}/api/items

### List crafted items with "iron" in the name or description
GET {{baseUrl}}/api/items?kind=crafted&search=iron

### List one category, newest first, five per page
GET {{baseUrl}}/api/items?category=Raw Material&sort=id&order=desc&pageSize=5

### Get one item with its recipe and uses
GET {{baseUrl}}/api/items/9

### Insert: create an item
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "name": "Copper Ore",
  "description": "Rock that contains copper.",
  "category": "Raw Material"
}

### Update: replace every field of an item (use the id returned by the insert)
PUT {{baseUrl}}/api/items/20
Content-Type: application/json

{
  "name": "Copper Ore",
  "description": "Soft orange rock that contains copper.",
  "category": "Raw Material"
}

### Partial update: change only the category
PATCH {{baseUrl}}/api/items/20
Content-Type: application/json

{
  "category": "Ore"
}

### Delete an item
DELETE {{baseUrl}}/api/items/20

### Rejected: the name is missing (400)
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "description": "An item with no name."
}

### Rejected: the name is already in use (409)
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "name": "stick"
}

### Rejected: the item does not exist (404)
GET {{baseUrl}}/api/items/9999

### Rejected: other recipes use the item as an ingredient (409)
DELETE {{baseUrl}}/api/items/9

# ---------------------------------------------------------------------------
# Recipes
# ---------------------------------------------------------------------------

### List recipes
GET {{baseUrl}}/api/recipes

### List the recipes that use Stick (item 9) as an ingredient
GET {{baseUrl}}/api/recipes?uses=9

### Get one recipe
GET {{baseUrl}}/api/recipes/4

### Insert, step 1: create the item the recipe will make
POST {{baseUrl}}/api/items
Content-Type: application/json

{
  "name": "Steel Ingot",
  "category": "Component"
}

### Insert, step 2: create its recipe (use the id returned by step 1)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "outputItemId": 20,
  "outputQuantity": 2,
  "craftSeconds": 15,
  "ingredients": [
    { "itemId": 10, "quantity": 3 },
    { "itemId": 3, "quantity": 1 }
  ]
}

### Update: replace the recipe (use the id returned by step 2)
PUT {{baseUrl}}/api/recipes/13
Content-Type: application/json

{
  "outputQuantity": 3,
  "craftSeconds": 20,
  "ingredients": [
    { "itemId": 10, "quantity": 4 },
    { "itemId": 2, "quantity": 1 }
  ]
}

### Delete the recipe. The item is kept and becomes raw
DELETE {{baseUrl}}/api/recipes/13

### Rejected: the item already has a recipe (409)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "outputItemId": 9,
  "ingredients": [
    { "itemId": 1, "quantity": 1 }
  ]
}

### Rejected: an item listed twice, and an item that does not exist (400)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "outputItemId": 1,
  "ingredients": [
    { "itemId": 3, "quantity": 1 },
    { "itemId": 3, "quantity": 2 },
    { "itemId": 777, "quantity": 1 }
  ]
}

### Rejected: Planks made from Sticks would loop, because Sticks are made from Planks (409)
PUT {{baseUrl}}/api/recipes/1
Content-Type: application/json

{
  "outputQuantity": 2,
  "ingredients": [
    { "itemId": 9, "quantity": 1 }
  ]
}

### Rejected: a loop five recipes deep (409)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "outputItemId": 1,
  "ingredients": [
    { "itemId": 18, "quantity": 1 }
  ]
}

# ---------------------------------------------------------------------------
# Ingredients
# ---------------------------------------------------------------------------

### List the ingredients of the Sword recipe
GET {{baseUrl}}/api/recipes/4/ingredients

### Add Coal (item 3) to the Sword recipe. Returns 201
PUT {{baseUrl}}/api/recipes/4/ingredients/3
Content-Type: application/json

{
  "quantity": 1
}

### Change its quantity. Same address, returns 200
PUT {{baseUrl}}/api/recipes/4/ingredients/3
Content-Type: application/json

{
  "quantity": 2
}

### Remove it again
DELETE {{baseUrl}}/api/recipes/4/ingredients/3

### Rejected: the only ingredient of a recipe cannot be removed (409)
DELETE {{baseUrl}}/api/recipes/1/ingredients/1

# ---------------------------------------------------------------------------
# Planning
# ---------------------------------------------------------------------------

### What it takes to make three Tool Kits (the worked example in the design document)
GET {{baseUrl}}/api/items/18/plan?quantity=3

### One Tool Kit: Sticks are needed by Sword and Pickaxe, and are rounded once, not twice
GET {{baseUrl}}/api/items/18/plan?quantity=1

### A Hunter Kit: bow, sixteen arrows, and a chest
GET {{baseUrl}}/api/items/19/plan

### A raw item: the plan is just the item itself
GET {{baseUrl}}/api/items/1/plan?quantity=5

### Rejected: the quantity is out of range (400)
GET {{baseUrl}}/api/items/18/plan?quantity=0

### The same plan as a downloadable file
GET {{baseUrl}}/api/items/18/plan/export?quantity=3

### The Sword's recipe tree, down to the raw materials
GET {{baseUrl}}/api/items/11/tree

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

### Totals, the most used ingredient, and the longest recipe chain
GET {{baseUrl}}/api/stats
